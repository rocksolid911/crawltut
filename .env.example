# Example Environment Variables
# Copy this file to .env and fill in your actual values

# API Keys (if using AI generation features)
API_KEY=your_api_key_here

# OpenAI API Key (if using OpenAI for data generation)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (optional, for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/election_data

# Crawler Settings
HEADLESS_BROWSER=True
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=crawler.log
